# Copy this file to .env and fill it in. .env is git-ignored; this example is not.
# simagent reads ./.env (or the file named by --env-file) when it starts. A variable that is
# already set in your shell wins over the file. Only LUNA_*, GMX_*, and SIMAGENT_* keys are read.
# On Linux keep the file private: chmod 600 .env

LUNA_API_KEY=
LUNA_BASE_URL=https://api.openai.com/v1
LUNA_MODEL=gpt-6-luna

# GROMACS (the default is the path in config.yaml)
# GMX_BIN=/home/rontu/Rontu/software/software_install/gromacs-2025.3/bin/gmx
# GMX_RUNS_DIR=./runs
